# ── Kredensial Supabase (migrasi database) ──────────────────────
# Isi SEMUA baris di bawah, lalu jalankan sql/schema.sql di Supabase
# SQL Editor, kemudian `npm run build` ulang.
# Tanpa file ini, website tetap jalan dalam mode lokal (localStorage).

# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — RAHASIA, hanya dipakai server (jangan dibagikan)
SUPABASE_SERVICE_ROLE_KEY=

# Email admin yang boleh membuka /admin — WAJIB DIISI.
# Supabase Auth mengizinkan siapa pun mendaftar akun sendiri, jadi token
# yang valid saja tidak cukup: tanpa daftar ini TIDAK ADA yang bisa masuk
# (fail closed). Pisahkan beberapa email dengan koma.
ADMIN_EMAIL=

# Domain utama toko (TANPA garis miring akhir) — dipakai link referral agen
# agar selalu menunjuk ke toko, bukan ke subdomain admin/agen tempat link
# disalin. Contoh: https://lembangonlinemart.com
# Kosong = pakai origin halaman saat itu (perilaku lama).
NEXT_PUBLIC_STORE_ORIGIN=
